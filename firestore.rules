rules_version = '2';

// Reglas de seguridad de Cloud Firestore para ColeTotal.
//
// Principios de diseño:
//  1. El rol del usuario se deriva del código de acceso verificado en el
//     servidor al crear su perfil en `usuarios/{uid}`.
//  2. Los códigos de acceso permiten lectura puntual (`get`) por identificador
//     exacto pero prohíben enumeración general (`list`), que queda restringida
//     al administrador activo de la garita correspondiente.
//  3. Las actualizaciones de perfil restringen explícitamente los campos
//     modificables para impedir escalamiento de privilegios o auto-activación.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isAdminOf(garitaId) {
      return signedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && me().rol == 'administrador'
        && me().activo == true
        && me().garitaId == garitaId;
    }

    function codigo(c) {
      return get(/databases/$(database)/documents/codigos_acceso/$(c)).data;
    }

    // Un sentido de un recorrido (ida o vuelta): puntos de control marcados en
    // el editor y polilínea codificada resultante del ajuste vial.
    function trayectoValido(t) {
      return t is map
        && t.puntos is list && t.puntos.size() <= 200
        && t.geometria is string && t.geometria.size() <= 300000;
    }

    // Estructura de una línea (recorrido): nombre, color, estado activo,
    // trazado de ida y trazado opcional de vuelta.
    function recorridoValido() {
      let d = request.resource.data;
      return d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 80
        && d.color is int
        && d.activo is bool
        && trayectoValido(d.ida)
        && (!('vuelta' in d) || trayectoValido(d.vuelta));
    }

    function codigoAccesoValido() {
      let d = request.resource.data;
      return d.size() == 3
        && d.garitaId is string && d.garitaId.size() > 0 && d.garitaId.size() <= 80
        && d.rol in ['colectivero', 'administrador']
        && d.activo is bool;
    }

    // Códigos de enrolamiento. El id del documento ES el código.
    match /codigos_acceso/{c} {
      allow get: if true;      // validable antes de registrarse…
      // Sólo el administrador activo de esa garita puede listar los códigos de su propia garita.
      allow list: if isAdminOf(resource.data.garitaId)
        && request.query.limit <= 100;
      allow create: if c.size() >= 4 && c.size() <= 40
        && isAdminOf(request.resource.data.garitaId)
        && codigoAccesoValido();
      allow update: if isAdminOf(resource.data.garitaId)
        && request.resource.data.garitaId == resource.data.garitaId
        && codigoAccesoValido();
      allow delete: if isAdminOf(resource.data.garitaId);
    }

    // Metadatos públicos de la garita. Los códigos NO están aquí: si lo
    // estuvieran, el primer conductor que se registrara podría leer el código de
    // administrador y ascenderse.
    match /garitas/{garitaId} {
      allow read: if true;
      allow write: if false;

      // Auditoría operacional de turnos de los conductores de la garita.
      match /auditoria_turnos/{sessionId} {
        allow read: if isAdminOf(garitaId);
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
          && me().garitaId == garitaId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.garitaId == garitaId
          && request.resource.data.eventos is list
          && request.resource.data.eventos.size() <= 500;
        allow update, delete: if false;
      }
    }

    match /usuarios/{uid} {
      allow get: if signedIn()
        && (request.auth.uid == uid || isAdminOf(resource.data.garitaId));

      // El administrador activo lista únicamente los usuarios de su propia garita.
      allow list: if isAdminOf(resource.data.garitaId)
        && request.query.limit <= 200;

      // Creación de perfil: el rol y la garita asignados deben coincidir con
      // los otorgados por el documento `codigos_acceso` referenciado.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['rol', 'nombre', 'garitaId', 'patente', 'email', 'activo', 'codigo'])
        && request.resource.data.rol in ['colectivero', 'administrador']
        && request.resource.data.activo == true
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 60
        && exists(/databases/$(database)/documents/codigos_acceso/$(request.resource.data.codigo))
        && codigo(request.resource.data.codigo).activo == true
        && codigo(request.resource.data.codigo).rol == request.resource.data.rol
        && codigo(request.resource.data.codigo).garitaId == request.resource.data.garitaId;

      // El titular de la cuenta sólo puede modificar su nombre visible.
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 60;

      // El administrador de la garita sólo puede habilitar o deshabilitar cuentas.
      allow update: if isAdminOf(resource.data.garitaId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activo']);

      allow delete: if false;
    }

    // Colección raíz de recorridos filtrable por `garitaId` y `activo`.
    match /recorridos/{id} {
      allow read: if true;
      allow create: if isAdminOf(request.resource.data.garitaId)
        && recorridoValido();
      // Una línea no puede cambiar de garita por la vía de un update.
      allow update: if isAdminOf(resource.data.garitaId)
        && request.resource.data.garitaId == resource.data.garitaId
        && recorridoValido();
      allow delete: if isAdminOf(resource.data.garitaId);
    }

    // Nada más es accesible.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
